    {
      "@id": "case-01",
      "@type": "Case",
      "label": "만천과해 고사",
      "description": "당 태종 동정(東征) 설화에서 설인귀가 황제를 배 안으로 유도해 바다를 건넜다는 전승 고사가 대표 사례로 전해진다."
    },
    {
      "@id": "stratagem-02",
      "@type": "Stratagem",
      "label": "위위구조",
      "description": "위나라를 포위해 조나라를 구하다",
      "belongsTo": [
        "family-1"
      ],
      "usesPrinciple": [
