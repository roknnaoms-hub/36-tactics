  "@graph": [
    {
      "@id": "Stratagem",
      "@type": "owl:Class",
      "label": "계책",
      "description": "36개 계책의 원문·해석·고사를 보존한 중심 개체"
    },
    {
      "@id": "Family",
      "@type": "owl:Class",
      "label": "계열",
      "description": "원천 데이터의 6대 분류"
    },
    {
      "@id": "Principle",
      "@type": "owl:Class",
      "label": "전략 원리",
      "description": "탐색을 위한 편집 해석; 고전 원문의 분류가 아님"
    },
    {
      "@id": "Situation",
      "@type": "owl:Class",
      "label": "적용 상황",
      "description": "비교 학습을 위한 편집 해석; 실행 권고가 아님"
    },
    {
      "@id": "Tag",
      "@type": "owl:Class",
      "label": "전략 태그",
      "description": "원천 데이터에 수록된 전략 키워드"
    },
    {
      "@id": "Domain",
      "@type": "owl:Class",
      "label": "적용 분야",
      "description": "원천 데이터의 현대적 적용 분야"
    },
    {
      "@id": "Case",
      "@type": "owl:Class",
      "label": "고사·사례",
      "description": "원천 데이터의 사례 설명; 역사적 사실 여부는 미검증"
    },
    {
      "@id": "Source",
      "@type": "owl:Class",
      "label": "참고 출처",
      "description": "원천 데이터가 제시한 참고 URL; 각 고사의 직접 증거를 뜻하지 않음"
    },
    {
      "@id": "belongsTo",
      "@type": "owl:ObjectProperty",
      "label": "속한다",
      "domain": "Stratagem",
      "range": "Family"
    },
    {
      "@id": "usesPrinciple",
      "@type": "owl:ObjectProperty",
      "label": "원리로 해석한다",
      "domain": "Stratagem",
      "range": "Principle"
    },
    {
      "@id": "suitedTo",
      "@type": "owl:ObjectProperty",
      "label": "상황과 연결한다",
      "domain": "Stratagem",
      "range": "Situation"
    },
    {
      "@id": "hasTag",
      "@type": "owl:ObjectProperty",
      "label": "태그를 갖는다",
      "domain": "Stratagem",
      "range": "Tag"
    },
    {
      "@id": "appliesTo",
      "@type": "owl:ObjectProperty",
      "label": "분야에 연결한다",
      "domain": "Stratagem",
      "range": "Domain"
    },
    {
      "@id": "illustratedBy",
      "@type": "owl:ObjectProperty",
      "label": "사례로 설명된다",
      "domain": "Stratagem",
      "range": "Case"
    },
    {
      "@id": "cites",
      "@type": "owl:ObjectProperty",
      "label": "참고한다",
      "domain": "Stratagem",
      "range": "Source"
    },
    {
      "@id": "family-1",
      "@type": "Family",
      "label": "승전계",
      "description": "제1계–제6계"
    },
    {
      "@id": "situation-1",
      "@type": "Situation",
      "label": "우세·준비",
      "description": "보유한 여유와 준비를 어떻게 활용하는가"
    },
    {
      "@id": "family-2",
      "@type": "Family",
      "label": "적전계",
      "description": "제7계–제12계"
    },
    {
      "@id": "situation-2",
      "@type": "Situation",
      "label": "대치·균형",
      "description": "상대와 맞서는 상황에서 무엇을 바꾸는가"
    },
    {
      "@id": "family-3",
      "@type": "Family",
      "label": "공전계",
      "description": "제13계–제18계"
    },
    {
      "@id": "situation-3",
      "@type": "Situation",
      "label": "접근·돌파",
      "description": "진전을 가로막는 조건을 어떻게 이해하는가"
    },
    {
      "@id": "family-4",
      "@type": "Family",
      "label": "혼전계",
      "description": "제19계–제24계"
    },
    {
      "@id": "situation-4",
      "@type": "Situation",
      "label": "혼란·변동",
      "description": "복잡한 관계와 변화 속에서 무엇을 관찰하는가"
    },
    {
      "@id": "family-5",
      "@type": "Family",
      "label": "병전계",
      "description": "제25계–제30계"
    },
    {
      "@id": "situation-5",
      "@type": "Situation",
      "label": "주도권 경쟁",
      "description": "관계와 구조에서 주도권은 어떻게 이동하는가"
    },
    {
      "@id": "family-6",
      "@type": "Family",
      "label": "패전계",
      "description": "제31계–제36계"
    },
    {
      "@id": "situation-6",
      "@type": "Situation",
      "label": "열세·위기",
      "description": "손실을 줄이고 선택지를 어떻게 보존하는가"
    },
    {
      "@id": "principle-conceal",
      "@type": "Principle",
      "label": "기만·은폐",
      "description": "관찰되는 모습과 실제 의도 사이의 차이를 분석합니다."
    },
    {
      "@id": "principle-indirect",
      "@type": "Principle",
      "label": "간접 접근",
      "description": "정면 대응 이외의 경로와 외부 자원의 관계를 분석합니다."
    },
    {
      "@id": "principle-timing",
      "@type": "Principle",
      "label": "시간·기회",
      "description": "대기, 완급과 상황 변화의 시점을 비교합니다."
    },
    {
      "@id": "principle-resource",
      "@type": "Principle",
      "label": "자원·보존",
      "description": "손실과 우선순위, 지속 가능한 자원 배분을 분석합니다."
    },
    {
      "@id": "principle-perception",
      "@type": "Principle",
      "label": "인식·심리",
      "description": "신뢰, 기대, 주의와 판단의 상호작용을 살펴봅니다."
    },
    {
      "@id": "principle-information",
      "@type": "Principle",
      "label": "정보·탐색",
      "description": "관찰, 반응, 정보의 신뢰성과 검증 구조를 살펴봅니다."
    },
    {
      "@id": "principle-conditions",
      "@type": "Principle",
      "label": "조건·환경 전환",
      "description": "경쟁이 벌어지는 조건과 맥락의 변화를 분석합니다."
    },
    {
      "@id": "principle-structure",
      "@type": "Principle",
      "label": "핵심·구조",
      "description": "전체를 지탱하는 요소와 의존 관계를 분석합니다."
    },
    {
      "@id": "principle-initiative",
      "@type": "Principle",
      "label": "주도권·관계",
      "description": "주체 사이의 영향력과 관계 변화에 주목합니다."
    },
    {
      "@id": "principle-combination",
      "@type": "Principle",
      "label": "연계·복합",
      "description": "여러 행동과 효과가 연결되는 구조를 살펴봅니다."
    },
