      ]
    },
    {
      "@id": "case-02",
      "@type": "Case",
      "label": "위위구조 고사",
      "description": "전국시대 계릉 전투에서 제나라 손빈이 위나라 수도 대량을 위협하여 조나라 포위를 풀게 한 고사가 핵심 전거로 알려져 있다."
    },
    {
      "@id": "stratagem-03",
      "@type": "Stratagem",
      "label": "차도살인",
      "description": "남의 칼을 빌려 사람을 해치다",
